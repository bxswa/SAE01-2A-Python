<?xml version="1.0" encoding="UTF-8"?>

<!--
  Fenetre principale : un onglet par ecran.
  Chaque sous-groupe remplace le Label "a venir" de son onglet par un
  <fx:include source="XXX.fxml"/> vers sa propre vue.
-->

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<TabPane tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <tabs>
      <Tab text="Configuration">
         <content>
            <fx:include source="Configuration.fxml" />
         </content>
      </Tab>
      <Tab text="Processus" />
      <Tab text="Gantt par processus" />
      <Tab text="Gantt par processeur">
         <content>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Aucune simulation encore detectée">
                     <font>
                        <Font name="System Bold Italic" size="24.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </content>
      </Tab>
      <Tab text="Comparaison">
         <content>
            <Label styleClass="a-venir" text="Écran à venir : métriques et graphiques de comparaison." />
         </content>
      </Tab>
   </tabs>
</TabPane>
