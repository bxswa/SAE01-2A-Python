<?xml version="1.0" encoding="UTF-8"?>

<!--
  Fenetre principale : un onglet par ecran.
  Chaque sous-groupe remplace le Label "a venir" de son onglet par un
  <fx:include source="XXX.fxml"/> vers sa propre vue.
-->

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iut.sae.controleur.PrincipaleControleur">
   <tabs>
      <Tab disable="true" text="Processus">
         <content>
            <Label styleClass="a-venir" text="Écran à venir : liste des processus et dates d'exécution." />
         </content>
      </Tab>
      <Tab disable="true" text="Gantt par processus">
         <content>
            <fx:include source="GanttProcessus.fxml" />
         </content>
      </Tab>
      <Tab disable="true" text="Gantt par processeur">
         <content>
            <Label styleClass="a-venir" text="Écran à venir : diagramme de Gantt par processeur et énergie." />
         </content>
      </Tab>
      <Tab disable="true" text="Comparaison">
         <content>
            <Label styleClass="a-venir" text="Écran à venir : métriques et graphiques de comparaison." />
         </content>
      </Tab>
      <Tab text="Configuration">
         <content>
            <fx:include source="Configuration.fxml" />
         </content>
      </Tab>
   </tabs>
</TabPane>
