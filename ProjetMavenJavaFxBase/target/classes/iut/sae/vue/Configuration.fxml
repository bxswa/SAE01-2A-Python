<?xml version="1.0" encoding="UTF-8"?>

<!--
  Ecran de configuration : creation / mise a jour du fichier config.txt.
  Controleur : iut.sae.controleur.ConfigurationControleur
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="iut.sae.controleur.ConfigurationControleur"
            styleClass="ecran">

   <!-- ===================== Formulaire (a gauche) ===================== -->
   <center>
      <ScrollPane fitToWidth="true" styleClass="defilement">
         <VBox spacing="16">
            <padding><Insets top="16" right="8" bottom="16" left="16"/></padding>

            <!-- 1. Fichiers d'entree -->
            <VBox spacing="10" styleClass="section">
               <Label text="1. Fichiers d'entrée" styleClass="titre-section"/>
               <GridPane hgap="10" vgap="8">
                  <columnConstraints>
                     <ColumnConstraints minWidth="150"/>
                     <ColumnConstraints hgrow="ALWAYS"/>
                     <ColumnConstraints/>
                  </columnConstraints>
                  <Label text="Processus (.csv)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfProcessus" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                  <Button text="Parcourir…" onAction="#parcourirProcessus" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                  <Label text="Ressources (.json)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfRessources" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                  <Button text="Parcourir…" onAction="#parcourirRessources" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                  <Label text="Énergie (.csv)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfEnergie" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                  <Button text="Parcourir…" onAction="#parcourirEnergie" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
               </GridPane>
            </VBox>

            <!-- 2. Algorithmes -->
            <VBox spacing="10" styleClass="section">
               <Label text="2. Algorithmes à comparer" styleClass="titre-section"/>
               <HBox spacing="24" alignment="CENTER_LEFT">
                  <CheckBox fx:id="cbFifo" text="FIFO"/>
                  <CheckBox fx:id="cbRoundRobin" text="Round Robin"/>
                  <CheckBox fx:id="cbEdf" text="EDF"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Label text="Quantum (Round Robin)"/>
                  <Spinner fx:id="spQuantum" prefWidth="90"/>
               </HBox>
               <Label text="Le quantum n'est modifiable que si Round Robin est coché." styleClass="aide"/>
            </VBox>

            <!-- 3. Fichiers de sortie -->
            <VBox spacing="10" styleClass="section">
               <Label text="3. Fichiers de sortie (écrits par Python dans le dossier Outputs)" styleClass="titre-section"/>
               <GridPane hgap="10" vgap="8">
                  <columnConstraints>
                     <ColumnConstraints minWidth="150"/>
                     <ColumnConstraints hgrow="ALWAYS"/>
                     <ColumnConstraints hgrow="ALWAYS"/>
                  </columnConstraints>
                  <Label text="Algorithme" styleClass="entete-colonne" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                  <Label text="Fichier global" styleClass="entete-colonne" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                  <Label text="Fichier des allocations" styleClass="entete-colonne" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                  <Label text="FIFO" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfGlobalFifo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                  <TextField fx:id="tfAllocationsFifo" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                  <Label text="Round Robin" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfGlobalRoundRobin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                  <TextField fx:id="tfAllocationsRoundRobin" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

                  <Label text="EDF" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfGlobalEdf" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                  <TextField fx:id="tfAllocationsEdf" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

                  <Label text="Fichier des métriques" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                  <TextField fx:id="tfMetriques" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
               </GridPane>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>

   <!-- ===================== Apercu et boutons (a droite) ===================== -->
   <right>
      <VBox spacing="10" prefWidth="380" styleClass="section">
         <BorderPane.margin><Insets top="16" right="16" bottom="16" left="8"/></BorderPane.margin>
         <Label text="Aperçu de config.txt" styleClass="titre-section"/>
         <Label fx:id="lblFichierConfig" styleClass="aide" wrapText="true"/>
         <TextArea fx:id="taApercu" editable="false" wrapText="false" styleClass="apercu" VBox.vgrow="ALWAYS"/>
         <HBox spacing="8">
            <Button text="Ouvrir un config…" onAction="#ouvrirConfig" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Valeurs par défaut" onAction="#reinitialiser" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
         </HBox>
         <Button text="Enregistrer config.txt…" onAction="#enregistrerConfig" defaultButton="true"
                 maxWidth="Infinity" styleClass="bouton-principal"/>
      </VBox>
   </right>

   <!-- ===================== Messages (en bas) ===================== -->
   <bottom>
      <Label fx:id="lblMessage" wrapText="true" styleClass="message">
         <BorderPane.margin><Insets top="0" right="16" bottom="12" left="16"/></BorderPane.margin>
      </Label>
   </bottom>
</BorderPane>
